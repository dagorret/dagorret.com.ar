---
import { ClientRouter } from 'astro:transitions';
import 'katex/dist/katex.min.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/800.css';
import '@fontsource/playfair-display/400-italic.css';
import '@fontsource/playfair-display/700-italic.css';
import '@fontsource/plus-jakarta-sans/300.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';

interface Props {
  title?: string;
  lang?: 'es' | 'en';
  frontmatter?: { title?: string; lang?: 'es' | 'en' };
  translationUrl?: string;
  category?: string;
}

const {
  title = Astro.props.frontmatter?.title ?? 'Carlos Dagorret',
  lang = Astro.props.frontmatter?.lang ?? 'es',
  translationUrl,
  category = 'MATEMÁTICAS',
} = Astro.props;
const isEnglish = lang === 'en';
const homeUrl = isEnglish ? '/en/' : '/';
const rssUrl = isEnglish ? '/en/rss.xml' : '/rss.xml';
const booksUrl = 'https://matematicas.dagorret.com.ar';
const navigation = [
  { href: booksUrl, label: isEnglish ? 'Books' : 'Libros', external: true },
  { href: isEnglish ? '/en/lab/' : '/lab/', label: 'Lab' },
  { href: isEnglish ? '/en/archive/' : '/archivo/', label: isEnglish ? 'Archive' : 'Archivo' },
  { href: isEnglish ? '/en/search/' : '/buscar/', label: isEnglish ? 'Search' : 'Buscador' },
  { href: rssUrl, label: 'RSS' },
];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ClientRouter />
  <title>{title} — Carlos Dagorret</title>
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={isEnglish ? 'Carlos Dagorret — English articles' : 'Carlos Dagorret — Artículos en español'} href={rssUrl} />

  <script is:inline>
    (() => {
      const theme = localStorage.getItem('theme');
      const dark = theme ? theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    })();
  </script>

  <style is:global>
    :root {
      --bg-header: #3b302a;
      --header-text: #faf3e8;
      --header-border: #6c5546;
      --card-bg: #f1eae0;
      --card-hover: #e8dbc9;
      --bg-body: #faf7f2;
      --text: #262422;
      --text-sub: #555555;
      --muted: #888884;
      --accent-rust: #9e5332;
      --border: #e5ded7;
      --font-serif: "Playfair Display", Georgia, serif;
      --font-sans: "Plus Jakarta Sans", -apple-system, sans-serif;
    }

    html.dark {
      --bg-header: #241f1b;
      --card-bg: #1c1a17;
      --card-hover: #2c241e;
      --bg-body: #0f1010;
      --text: #eceae4;
      --text-sub: #b0ada6;
      --muted: #82807a;
      --accent-rust: #d97855;
      --border: #262826;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-sans);
      background: var(--bg-body);
      color: var(--text);
      line-height: 1.85;
      font-size: 1.05rem;
      transition: background 0.2s ease, color 0.2s ease;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    h1, h2, h3 {
      font-family: var(--font-serif);
      font-weight: 700;
      letter-spacing: -0.015em;
      color: var(--text);
    }

    h1 {
      font-size: clamp(2.5rem, 6vw, 3.75rem);
      font-weight: 800;
      line-height: 1.15;
      margin-bottom: 1.25rem;
    }

    /* HEADER COMPACTO Y CENTRADO */
    header.site-header {
      background: var(--bg-header);
      color: var(--header-text);
      border-bottom: 1px solid var(--header-border);
      width: 100%;
    }

    .header-inner {
      max-width: 1100px;
      width: 92%;
      margin: 0 auto;
      padding: 22px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px 24px;
    }

    .brand-logo {
      font-family: var(--font-serif);
      font-size: 1.85rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: var(--header-text);
    }

    .nav-group {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 22px;
      font-size: 0.88rem;
    }

    @media (max-width: 600px) {
      .header-inner { justify-content: center; }
      .nav-group { width: 100%; justify-content: center; gap: 10px 16px; }
    }

    .nav-group a {
      color: var(--header-text);
    }
    .nav-group a:hover {
      color: #edbc95;
    }

    .pill-btn {
      font-size: 0.76rem;
      font-weight: 600;
      padding: 3px 9px;
      border-radius: 9999px;
      border: 1px solid var(--header-border);
      background: transparent;
      color: var(--header-text);
      cursor: pointer;
    }
    .pill-btn.disabled {
      opacity: 0.35;
      cursor: not-allowed;
      pointer-events: none;
    }

    .theme-toggle-btn {
      background: none;
      border: none;
      color: var(--header-text);
      cursor: pointer;
      font-size: 1rem;
      padding: 2px 4px;
    }

    /* Marco amplio; el cuerpo del artículo conserva su propia medida de lectura. */
    main.article-container {
      max-width: 1100px;
      width: 92%;
      margin: 0 auto;
      padding: clamp(2.5rem, 6vw, 4.5rem) 0 100px;
    }

    /* ENCABEZADO DEL POST */
    .article-header {
      max-width: 72ch;
      margin-inline: auto;
      font-size: 1.08rem;
      margin-bottom: 40px;
    }

    .article-meta-line {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.76rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 14px;
    }

    .meta-cat {
      color: var(--accent-rust);
    }

    .meta-date {
      color: var(--muted);
      font-weight: 400;
    }

    .article-title {
      font-family: var(--font-serif);
      font-size: clamp(2.5rem, 6vw, 3.75rem);
      line-height: 1.15;
      font-weight: 800;
      letter-spacing: -0.015em;
      margin-bottom: 20px;
      color: var(--text);
    }

    /* CUERPO DEL TEXTO */
    .article-body {
      max-width: 72ch;
      margin-inline: auto;
      font-size: 1.08rem;
      min-width: 0;
      overflow-wrap: break-word;
    }

    .article-body p {
      font-size: 1.08rem;
      line-height: 1.85;
      margin-bottom: 1.7rem;
      color: var(--text);
    }

    .article-body h2 {
      font-family: var(--font-serif);
      font-size: 2.15rem;
      font-weight: 700;
      margin-top: 3.5rem;
      margin-bottom: 1.2rem;
      line-height: 1.25;
      color: var(--text);
    }

    .article-body h3 {
      font-family: var(--font-serif);
      font-size: 1.6rem;
      font-weight: 700;
      margin-top: 2.5rem;
      margin-bottom: 0.8rem;
    }

    /* CITAS TEXTUALES */
    .article-body blockquote {
      border-left: 2px solid var(--accent-rust);
      padding: 0 0 0 1.5rem;
      margin: 2rem 0;
      font-family: var(--font-serif);
      font-size: 1.4rem;
      line-height: 1.45;
      font-style: italic;
      color: var(--text-sub);
    }

    .article-body blockquote p {
      font-size: inherit;
      line-height: inherit;
      color: inherit;
    }

    .article-body blockquote > :last-child { margin-bottom: 0; }

    .article-body hr {
      border: 0;
      border-top: 1px solid var(--border);
      margin: 2rem 0;
    }

    .article-body :is(.note, .footnotes) {
      border-top: 1px solid var(--border);
      padding-top: 1rem;
      margin: 2rem 0;
      font-size: 0.9rem;
      color: var(--text-sub);
    }

    .article-body :is(.note, .footnotes) p { font-size: inherit; color: inherit; }

    .article-body figcaption {
      font-size: 0.85rem;
      line-height: 1.6;
      color: var(--text-sub);
      margin-top: 0.75rem;
    }

    /* Usar estas clases en wrappers de gráficos o tablas, dentro de article-body. */
    .article-body :is(.figure-wide, .full-width) {
      --figure-width: min(960px, calc(100vw - 3rem));
      width: var(--figure-width);
      max-width: none;
      margin-block: 2rem;
      margin-inline: calc((100% - var(--figure-width)) / 2);
      overflow-x: auto;
    }

    .article-body .full-width { --figure-width: calc(100vw - 3rem); }

    .article-body :is(.table-scroll, pre) {
      max-width: 100%;
      overflow-x: auto;
    }

    .article-body table {
      display: block;
      max-width: 100%;
      overflow-x: auto;
      border-collapse: collapse;
      margin-block: 2rem;
      font-size: 0.9rem;
    }

    .article-body :is(th, td) {
      padding: 0.6rem 0.8rem;
      border-bottom: 1px solid var(--border);
      text-align: start;
    }

    .article-body :is(canvas, iframe) { max-width: 100%; }

    /* IMÁGENES Y DIAGRAMAS SVG */
    .article-body img,
    .article-body svg {
      max-width: 100% !important;
      height: auto !important;
      display: block;
      margin: 3.2rem auto;
      border-radius: 4px;
    }

    /* TABLAS Y FÓRMULAS */
    .katex-display {
      overflow-x: auto;
      overflow-y: hidden;
      padding: 16px 0;
    }

    .site-footer {
      max-width: 1100px;
      width: 92%;
      margin: 0 auto;
      padding: 1.75rem 0 2.5rem;
      border-top: 1px solid var(--border);
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem 2rem;
      color: var(--text-sub);
      font-size: 0.8rem;
    }
    .site-footer nav { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; }
    .site-footer a:hover, .site-footer a:focus-visible { color: var(--accent-rust); }
    .site-footer small { font-size: inherit; }

  </style>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href={homeUrl} class="brand-logo">Carlos Dagorret</a>

      <nav class="nav-group" aria-label={isEnglish ? 'Main navigation' : 'Navegación principal'}>
        {navigation.map(link => (
          <a href={link.href} target={'external' in link ? '_blank' : undefined} rel={'external' in link ? 'noopener noreferrer' : undefined}>{link.label}</a>
        ))}

        {translationUrl ? (
          <a href={translationUrl} class="pill-btn" aria-label={isEnglish ? 'Read in Spanish' : 'Leer en inglés'}>
            {lang === 'es' ? 'EN' : 'ES'}
          </a>
        ) : (
          <span class="pill-btn disabled" aria-disabled="true" aria-label={isEnglish ? 'Translation unavailable' : 'Traducción no disponible'}>
            {lang === 'es' ? 'EN' : 'ES'}
          </span>
        )}

        <button id="theme-toggle" class="theme-toggle-btn" aria-label={isEnglish ? 'Toggle theme' : 'Cambiar tema'}>◐</button>
      </nav>
    </div>
  </header>

  <main class="article-container">
    <slot />
  </main>

  <footer class="site-footer">
    <nav aria-label={isEnglish ? 'Footer navigation' : 'Navegación del pie de página'}>
      <a href="mailto:carlos@dagorret.com.ar">{isEnglish ? 'Contact' : 'Contacto'}</a>
      <a href={booksUrl} target="_blank" rel="noopener noreferrer">{isEnglish ? 'Books' : 'Libros'}</a>
      <a href={rssUrl}>RSS</a>
    </nav>
    <small>© Carlos Dagorret</small>
  </footer>

  <script>
    import { onPageLoad } from '../lib/page-lifecycle';

    document.addEventListener('astro:after-swap', () => {
      const theme = localStorage.getItem('theme');
      const dark = theme ? theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    });

    onPageLoad('#theme-toggle', button => {
      button.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    });
  </script>
</body>
</html>
