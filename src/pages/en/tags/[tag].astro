---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import TagListing from '../../../components/TagListing.astro';
import { tagPaths } from '../../../lib/tags';

export const getStaticPaths = (async () => tagPaths('en')) satisfies GetStaticPaths;
interface Props { label: string; posts: CollectionEntry<'blog'>[]; }
const { label, posts } = Astro.props;
---

<TagListing lang="en" label={label} posts={posts} />
