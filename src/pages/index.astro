---
import PostIndex from '../components/PostIndex.astro';
import { sortedPosts, POSTS_PER_PAGE } from '../lib/posts';

const posts = await sortedPosts('es');
---

<PostIndex lang="es" posts={posts.slice(0, POSTS_PER_PAGE)} currentPage={1} lastPage={Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE))} />
