---
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: 'es' | 'en';
  prevPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { lang, prevPost, nextPost } = Astro.props;
const en = lang === 'en';
const prefix = en ? '/en' : '';
---

{(prevPost || nextPost) && (
  <nav class="post-nav" aria-label={en ? 'Previous and next articles' : 'Artículo anterior y siguiente'}>
    {prevPost && (
      <a class="post-card prev" href={`${prefix}/${prevPost.data.slug}/`} rel="prev">
        <span class="nav-label">{en ? '← Previous' : '← Anterior'}</span>
        <span class="nav-title">{prevPost.data.title}</span>
      </a>
    )}
    {nextPost && (
      <a class="post-card next" href={`${prefix}/${nextPost.data.slug}/`} rel="next">
        <span class="nav-label">{en ? 'Next →' : 'Siguiente →'}</span>
        <span class="nav-title">{nextPost.data.title}</span>
      </a>
    )}
  </nav>
)}

<style>
  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow-wrap: break-word;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }
  .post-card.next { grid-column: 2; text-align: right; }
  .nav-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-rust);
  }
  .nav-title {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.3vw, 1.5rem);
    font-weight: 700;
    line-height: 1.35;
  }
  .post-card:hover, .post-card:focus-visible {
    background: var(--card-hover);
    border-color: var(--accent-rust);
    transform: translateY(-3px);
  }
  .post-card:focus-visible { outline: 2px solid var(--accent-rust); outline-offset: 4px; }
  @media (max-width: 600px) {
    .post-nav { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .post-card.next { grid-column: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-card { transition: none; }
    .post-card:hover, .post-card:focus-visible { transform: none; }
  }
</style>
