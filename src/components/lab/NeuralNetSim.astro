---
import { initialNetwork, forward, connections, type Inputs } from '../../lib/neural-network';

interface Props { lang?: 'es' | 'en'; }
const { lang = 'es' } = Astro.props;
const en = lang === 'en';
const inputs: Inputs = [0.5, 0.25];
const network = initialNetwork();
const pass = forward(network, inputs, 'sigmoid', 0.8);
const edges = connections(network, inputs, pass);
const nodes = [
  { x: 120, y: 130, label: 'x₁', value: inputs[0] },
  { x: 120, y: 230, label: 'x₂', value: inputs[1] },
  ...pass.hidden.map((value, j) => ({ x: 380, y: 80 + 100 * j, label: `h${j + 1}`, value })),
  { x: 640, y: 180, label: 'ŷ', value: pass.output },
];
const format = new Intl.NumberFormat(lang, { maximumFractionDigits: 4 });
---

<figure class="neural-sim" data-lang={lang}>
  <figcaption class="nn-heading"><strong>{en ? 'Neural network · 2 → 3 → 1' : 'Red neuronal · 2 → 3 → 1'}</strong><span>{en ? 'One example, one training step' : 'Un ejemplo, un paso de entrenamiento'}</span></figcaption>
  <div class="nn-controls">
    <label>x₁ <output data-value="x1">0.5</output><input type="range" data-input="x1" min="-1" max="1" step="0.01" value="0.5" /></label>
    <label>x₂ <output data-value="x2">0.25</output><input type="range" data-input="x2" min="-1" max="1" step="0.01" value="0.25" /></label>
    <label>{en ? 'Target t' : 'Objetivo t'} <output data-value="target">0.8</output><input type="range" data-input="target" min="0" max="1" step="0.01" value="0.8" /></label>
    <label>{en ? 'Hidden activation' : 'Activación oculta'}<select data-activation><option value="sigmoid">{en ? 'Sigmoid' : 'Sigmoide'}</option><option value="relu">ReLU</option></select></label>
    <label>{en ? 'Learning rate η' : 'Tasa de aprendizaje η'}<select data-learning-rate><option value="0.1">0.1</option><option value="0.5" selected>0.5</option><option value="1">1</option></select></label>
  </div>
  <div class="nn-viewport">
    <svg class="nn-svg" viewBox="0 0 760 360" role="img" aria-label={en ? 'Network with two inputs, three hidden neurons, and one sigmoid output. Node values are also provided in the calculation table.' : 'Red con dos entradas, tres neuronas ocultas y una salida sigmoide. Los valores también están en la tabla de cálculo.'}>
      <text x="120" y="28" class="nn-layer">{en ? 'Inputs' : 'Entradas'}</text>
      <text x="380" y="28" class="nn-layer">{en ? 'Hidden layer' : 'Capa oculta'}</text>
      <text x="640" y="28" class="nn-layer">{en ? 'Output · sigmoid' : 'Salida · sigmoide'}</text>
      {edges.map((edge, i) => (
        <line class="nn-edge" data-edge={i} x1={nodes[edge.from].x} y1={nodes[edge.from].y} x2={nodes[edge.to].x} y2={nodes[edge.to].y}>
          <title>{`w = ${edge.weight}; a = ${edge.source}; w × a = ${edge.contribution}`}</title>
        </line>
      ))}
      {nodes.map((node, i) => (
        <g data-node={i}>
          <circle class="nn-node-base" cx={node.x} cy={node.y} r="33" />
          <circle class="nn-node-fill" cx={node.x} cy={node.y} r="33" />
          <text class="nn-node-label" x={node.x} y={node.y - 45}>{node.label}</text>
          <text class="nn-node-value" x={node.x} y={node.y + 5}>{format.format(node.value)}</text>
        </g>
      ))}
    </svg>
  </div>
  <p class="nn-legend"><span class="positive">●</span> {en ? 'Positive contribution' : 'Contribución positiva'} <span class="negative">●</span> {en ? 'Negative contribution' : 'Contribución negativa'}</p>
  <p class="nn-help">{en ? 'Edge thickness shows |weight × source activation|. Node intensity shows activation magnitude, saturating at 1. The output always uses sigmoid. On small screens, scroll the diagram horizontally.' : 'El grosor muestra |peso × activación de origen|. La intensidad del nodo muestra la magnitud de activación y se satura en 1. La salida siempre usa sigmoide. En pantallas pequeñas, desplazá el diagrama horizontalmente.'}</p>
  <dl class="nn-metrics">
    <div><dt>{en ? 'Prediction ŷ' : 'Predicción ŷ'}</dt><dd data-prediction>{format.format(pass.output)}</dd></div>
    <div><dt>{en ? 'Loss ½(ŷ − t)²' : 'Pérdida ½(ŷ − t)²'}</dt><dd data-loss>{format.format(pass.loss)}</dd></div>
    <div><dt>{en ? 'Training steps' : 'Pasos de entrenamiento'}</dt><dd data-steps>0</dd></div>
  </dl>
  <div class="nn-actions">
    <button type="button" data-train>{en ? 'Training step / Adjust weights' : 'Paso de entrenamiento / Ajustar pesos'}</button>
    <button type="button" data-reset>{en ? 'Reset' : 'Reiniciar'}</button>
  </div>
  <p class="nn-feedback" role="status" aria-live="polite">{en ? 'Adjust the inputs, choose a target, and train on this example.' : 'Ajustá las entradas, elegí un objetivo y entrená sobre este ejemplo.'}</p>
  <details class="nn-details"><summary>{en ? 'Inspect calculations and weights' : 'Inspeccionar cálculos y pesos'}</summary>
    <div class="table-scroll"><table>
      <thead><tr><th>{en ? 'Neuron' : 'Neurona'}</th><th>z</th><th>{en ? 'Activation' : 'Activación'}</th><th>{en ? 'Weights' : 'Pesos'}</th><th>{en ? 'Bias' : 'Sesgo'}</th></tr></thead>
      <tbody>{[0, 1, 2, 3].map(j => <tr data-calculation={j}><th>{j === 3 ? 'ŷ' : `h${j + 1}`}</th><td data-z></td><td data-a></td><td data-w></td><td data-b></td></tr>)}</tbody>
    </table></div>
  </details>
  <noscript><p>{en ? 'Enable JavaScript to change inputs and train the network. The diagram shows its initial prediction.' : 'Activá JavaScript para modificar las entradas y entrenar la red. El diagrama muestra la predicción inicial.'}</p></noscript>
</figure>

<style is:global>
  .neural-sim { --nn-positive: var(--accent-rust, #9e5332); --nn-negative: #517575; background: var(--bg-body); color: var(--text); border: 1px solid var(--border); border-radius: 8px; padding: clamp(1rem, 3vw, 2rem); margin: 0; }
  .neural-sim .nn-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; font-size: 0.8rem; margin: 0 0 1.5rem; }
  .neural-sim .nn-heading span { color: var(--text-sub); }
  .neural-sim .nn-controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 1.5rem; }
  .neural-sim label { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem; font: 600 0.75rem var(--font-sans); color: var(--text-sub); }
  .neural-sim label output { color: var(--accent-rust); font-variant-numeric: tabular-nums; }
  .neural-sim input { width: 100%; accent-color: var(--accent-rust); min-height: 24px; }
  .neural-sim select { width: 100%; min-height: 42px; padding: 0.5rem; border: 1px solid var(--border); border-radius: 4px; background: var(--card-bg); color: var(--text); font: 0.8rem var(--font-sans); }
  .neural-sim .nn-viewport { overflow-x: auto; margin: 1.5rem 0 0; }
  .neural-sim .nn-svg { display: block; width: 100%; min-width: 520px; height: auto; margin: 0; }
  .neural-sim .nn-layer { fill: var(--text-sub); font: 12px var(--font-sans); text-anchor: middle; }
  .neural-sim .nn-edge { stroke: var(--nn-positive); stroke-width: 2; }
  .neural-sim .nn-node-base { fill: var(--bg-body); stroke: var(--border); stroke-width: 2; }
  .neural-sim .nn-node-fill { fill: var(--nn-positive); fill-opacity: 0.15; }
  .neural-sim .nn-node-label { fill: var(--text-sub); text-anchor: middle; font: 600 13px var(--font-sans); }
  .neural-sim .nn-node-value { fill: var(--text); text-anchor: middle; font: 600 14px var(--font-sans); font-variant-numeric: tabular-nums; }
  .neural-sim .nn-legend, .neural-sim .nn-help { font: 0.75rem/1.7 var(--font-sans); color: var(--text-sub); margin: 0.5rem 0; }
  .neural-sim .positive { color: var(--nn-positive); }
  .neural-sim .negative { color: var(--nn-negative); margin-left: 0.75rem; }
  .neural-sim .nn-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 1.5rem 0; }
  .neural-sim .nn-metrics > div { padding: 1rem; background: var(--card-bg); border-radius: 4px; }
  .neural-sim dt { font: 0.7rem/1.5 var(--font-sans); color: var(--text-sub); }
  .neural-sim dd { font: 700 clamp(1rem, 2vw, 1.5rem)/1.5 var(--font-serif); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .neural-sim .nn-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .neural-sim button { padding: 0.8rem 1rem; border: 1px solid var(--accent-rust); border-radius: 4px; background: var(--accent-rust); color: var(--bg-body); font: 600 0.8rem var(--font-sans); cursor: pointer; }
  .neural-sim button[data-reset] { color: var(--accent-rust); background: transparent; }
  .neural-sim button:hover { filter: brightness(1.1); }
  .neural-sim :is(button, input, select):focus-visible { outline: 2px solid var(--accent-rust); outline-offset: 3px; }
  .neural-sim .nn-feedback { min-height: 2.5em; margin: 1rem 0; font: 0.8rem/1.7 var(--font-sans); color: var(--text-sub); }
  .neural-sim .nn-details { font-size: 0.8rem; }
  .neural-sim summary { cursor: pointer; color: var(--accent-rust); }
  @media (max-width: 600px) { .neural-sim .nn-controls { grid-template-columns: minmax(0, 1fr); } .neural-sim .nn-metrics { gap: 0.5rem; } .neural-sim .nn-metrics > div { padding: 0.75rem 0.5rem; } }
</style>

<script>
  import { onPageLoad } from '../../lib/page-lifecycle';
  import { initialNetwork, forward, trainStep, connections, type Activation, type Inputs } from '../../lib/neural-network';

  onPageLoad<HTMLElement>('.neural-sim', root => {
    const en = root.dataset.lang === 'en';
    const number = new Intl.NumberFormat(en ? 'en' : 'es', { maximumFractionDigits: 4 });
    const precise = new Intl.NumberFormat(en ? 'en' : 'es', { maximumSignificantDigits: 6 });
    const control = (name: string) => root.querySelector<HTMLInputElement>(`[data-input="${name}"]`)!;
    const activationControl = root.querySelector<HTMLSelectElement>('[data-activation]')!;
    const rateControl = root.querySelector<HTMLSelectElement>('[data-learning-rate]')!;
    const feedback = root.querySelector<HTMLElement>('.nn-feedback')!;
    let network = initialNetwork();
    let steps = 0;
    const inputs = (): Inputs => [Number(control('x1').value), Number(control('x2').value)];
    const activation = () => activationControl.value as Activation;
    const target = () => Number(control('target').value);

    function render() {
      const pass = forward(network, inputs(), activation(), target());
      for (const name of ['x1', 'x2', 'target']) root.querySelector<HTMLOutputElement>(`[data-value="${name}"]`)!.textContent = number.format(Number(control(name).value));
      const values = [...inputs(), ...pass.hidden, pass.output];
      for (const [i, value] of values.entries()) {
        const group = root.querySelector<SVGGElement>(`[data-node="${i}"]`)!;
        group.querySelector('.nn-node-value')!.textContent = number.format(value);
        const fill = group.querySelector<SVGCircleElement>('.nn-node-fill')!;
        fill.style.fill = value < 0 ? 'var(--nn-negative)' : 'var(--nn-positive)';
        fill.style.fillOpacity = String(0.08 + 0.65 * Math.min(Math.abs(value), 1));
      }
      for (const [i, edge] of connections(network, inputs(), pass).entries()) {
        const line = root.querySelector<SVGLineElement>(`[data-edge="${i}"]`)!;
        line.style.stroke = edge.contribution < 0 ? 'var(--nn-negative)' : 'var(--nn-positive)';
        line.style.strokeWidth = String(0.75 + 4 * Math.min(Math.abs(edge.contribution), 2));
        line.style.opacity = String(0.2 + 0.8 * Math.min(Math.abs(edge.contribution), 1));
        line.querySelector('title')!.textContent = `w = ${precise.format(edge.weight)}; a = ${precise.format(edge.source)}; w × a = ${precise.format(edge.contribution)}`;
      }
      root.querySelector('[data-prediction]')!.textContent = precise.format(pass.output);
      root.querySelector('[data-loss]')!.textContent = precise.format(pass.loss);
      root.querySelector('[data-steps]')!.textContent = String(steps);
      for (let j = 0; j < 4; j++) {
        const row = root.querySelector(`[data-calculation="${j}"]`)!;
        row.querySelector('[data-z]')!.textContent = precise.format(j === 3 ? pass.outputZ : pass.hiddenZ[j]);
        row.querySelector('[data-a]')!.textContent = precise.format(j === 3 ? pass.output : pass.hidden[j]);
        row.querySelector('[data-w]')!.textContent = (j === 3 ? network.w2 : network.w1[j]).map(w => precise.format(w)).join(' · ');
        row.querySelector('[data-b]')!.textContent = precise.format(j === 3 ? network.b2 : network.b1[j]);
      }
      return pass;
    }

    for (const input of root.querySelectorAll<HTMLInputElement>('input')) input.addEventListener('input', () => {
      render(); feedback.textContent = en ? 'Example updated. Weights are unchanged until you train.' : 'Ejemplo actualizado. Los pesos no cambian hasta entrenar.';
    });
    activationControl.addEventListener('change', () => {
      render(); feedback.textContent = en ? 'Hidden activation updated. The output still uses sigmoid.' : 'Activación oculta actualizada. La salida sigue usando sigmoide.';
    });
    root.querySelector('[data-train]')!.addEventListener('click', () => {
      const result = trainStep(network, inputs(), activation(), target(), Number(rateControl.value));
      if (result.accepted) {
        network = result.network; steps++;
        feedback.textContent = `${en ? 'Loss' : 'Pérdida'}: ${precise.format(result.before.loss)} → ${precise.format(result.after.loss)}. η = ${precise.format(result.rate)}.`;
      } else feedback.textContent = en ? 'No reducing step found: the local gradient may be zero or numerically negligible.' : 'No se encontró un paso que reduzca la pérdida: el gradiente local puede ser nulo o numéricamente despreciable.';
      render();
    });
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      network = initialNetwork(); steps = 0;
      control('x1').value = '0.5'; control('x2').value = '0.25'; control('target').value = '0.8'; activationControl.value = 'sigmoid'; rateControl.value = '0.5';
      render(); feedback.textContent = en ? 'Initial inputs and weights restored.' : 'Entradas y pesos iniciales restaurados.';
    });
    render();
  });
</script>
