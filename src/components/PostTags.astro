---
import type { CollectionEntry } from 'astro:content';
import { postTopics } from '../lib/tags';

interface Props {
  lang: 'es' | 'en';
  data: CollectionEntry<'blog'>['data'];
}

const { lang, data } = Astro.props;
const topics = postTopics(data);
---

{topics.length > 0 && (
  <footer class="post-topics" aria-label={lang === 'en' ? 'Tags and categories' : 'Etiquetas y categorías'} data-pagefind-ignore>
    <ul>
      {topics.map((label) => <li>{label}</li>)}
    </ul>
  </footer>
)}

<style>
  .post-topics { max-width: 72ch; margin: 2.5rem auto 0; padding-top: 1.25rem; border-top: 1px solid var(--border); font-size: 1.08rem; }
  ul { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; }
  li { padding: 0.3rem 0.8rem; border: 1px solid var(--border); border-radius: 999px; background: var(--card-bg); color: var(--text-sub); font-size: 0.75rem; line-height: 1.5; }
</style>
